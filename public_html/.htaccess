# Vizesel
Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
RewriteEngine On

# SSL sertifika doğrulaması (Let's Encrypt) her zaman serbest
RewriteRule ^\.well-known/ - [L]

# Tek adres: https://www.vizesel.com (http ve www'siz istekler buraya yönlenir)
RewriteCond %{HTTP_HOST} ^vizesel\.com$ [NC]
RewriteRule ^ https://www.vizesel.com%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP_HOST} ^www\.vizesel\.com$ [NC]
RewriteRule ^ https://www.vizesel.com%{REQUEST_URI} [L,R=301]

# Gizli dosyalar
RewriteRule (^|/)\.(?!well-known/) - [F]

# TRACE/TRACK kapalı
RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK)$ [NC]
RewriteRule ^ - [F]

# index.php dışındaki .php dosyaları çalıştırılmaz (yüklenmiş zararlı dosyalara karşı)
RewriteCond %{REQUEST_URI} !^/index\.php$
RewriteRule \.(php[0-9]?|phtml|phar)$ - [F,NC]

# Var olan dosyalar doğrudan, gerisi index.php
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
RewriteRule ^ index.php [L,QSA]
</IfModule>

# Hassas dosya türleri ve hosting'in hata kaydı tarayıcıya hiç verilmez
<FilesMatch "(^error_log$|^php_errorlog$|\.(sql|sqlite|db|md|yml|yaml|log|ini|env|bak|old|orig|save|swp|tmp|sh|dist|lock|zip|tar|gz)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
# Sayfalarda (PHP) aynı başlıklar ayrıca index.php üzerinden de gönderilir; burası statik dosyalar için.
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set X-Frame-Options "DENY"
Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
# HTTPS zorunluluğu (http zaten https'e yönlenir; tarayıcı bunu bir yıl hatırlar)
Header set Strict-Transport-Security "max-age=31536000"
Header unset X-Powered-By
<FilesMatch "\.(woff2|webp|png|svg|ico)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
# Favicon adresleri sabit kalır, içerik değişebilir: bir hafta önbellek
<FilesMatch "^(favicon\.(ico|svg)|favicon-\d+x\d+\.png|apple-touch-icon\.png|web-app-manifest-\d+x\d+\.png|site\.webmanifest)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
<FilesMatch "\.(css|js)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

AddType font/woff2 .woff2
AddType image/webp .webp
AddType image/x-icon .ico
AddType application/manifest+json .webmanifest
