# Vizesel
Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
RewriteEngine On

# www ve http -> https://vizesel.com (SSL etkin olduktan sonra çalışır)
RewriteCond %{HTTP_HOST} ^www\.vizesel\.com$ [NC]
RewriteRule ^ https://vizesel.com%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP_HOST} ^vizesel\.com$ [NC]
RewriteRule ^ https://vizesel.com%{REQUEST_URI} [L,R=301]

# Gizli dosyalar
RewriteRule (^|/)\. - [F]

# Var olan dosyalar doğrudan, gerisi index.php
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
<FilesMatch "\.(woff2|webp|png|svg|ico)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(css|js)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

AddType font/woff2 .woff2
AddType image/webp .webp
